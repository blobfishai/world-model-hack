# Reactor: https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Google AI Studio: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=

# Room reconstruction and local physics (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
ROOM_SIM_URL=http://127.0.0.1:8000
# Optional: set these together when using a different physics-service port.
# ROOM_SIM_PORT=8000
# NEXT_PUBLIC_ROOM_SIM_WS_URL=ws://127.0.0.1:8000

# Reactor world gym (/world). Optional; defaults shown.
# REACTOR_WORLD_AUTOSCAN=1        # scan a new world's rooms with LingBot World 2 right after planning (paid)
# REACTOR_WORLD_SESSIONS=1        # concurrent server-side Reactor sessions (account limit: 5 concurrent, 10/min)
# ROOM_SIM_EXTRA_ORIGINS=         # comma-separated extra browser origins for the rooms-server WebSockets
